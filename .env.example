# 服务
HOST=127.0.0.1
PORT=4317
TIMEZONE=Asia/Shanghai
AUTH_JSON_PATH=/absolute/path/to/auth.json
POLL_INTERVAL_MINUTES=60
DATABASE_PATH=./data/quota-monitor.sqlite

# 上游（通常无需修改）
CODEX_BASE_URL=https://chatgpt.com
CODEX_RESETS_URL=https://codex-resets.com/api/resets

# 如果访问 ChatGPT 需要代理，取消注释并填写
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NODE_USE_ENV_PROXY=1

# 邮件；未完整配置时仅在页面记录告警，不发送邮件
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=codex-monitor@example.com
MAIL_TO=owner@example.com
