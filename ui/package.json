{
  "name": "@quotatide/ui",
  "version": "0.2.0",
  "private": true,
  "repository": "https://github.com/TheBlindM/QuotaTide",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:browser && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "preact": "10.29.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/preact": "3.2.4",
    "@types/node": "26.1.2",
    "@vitest/browser-playwright": "4.1.10",
    "axe-core": "^4.10.3",
    "eslint": "10.8.0",
    "jsdom": "30.0.0",
    "playwright": "1.62.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
