{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaTide",
  "version": "0.1.0",
  "identifier": "dev.theblind.quotatide",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "QuotaTide",
        "width": 420,
        "height": 680,
        "minWidth": 420,
        "minHeight": 680,
        "maxWidth": 420,
        "maxHeight": 680,
        "center": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray/tray-color.png",
      "tooltip": "QuotaTide"
    },
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "copyright": "Copyright © 2026 TheBlind",
    "shortDescription": "A private Codex quota tray monitor.",
    "longDescription": "QuotaTide is an independent open-source tray application for monitoring one Codex account on this device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
