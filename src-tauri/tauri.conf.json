{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaTide",
  "version": "0.1.1",
  "identifier": "dev.theblind.quotatide",
  "mainBinaryName": "quotatide",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm run --prefix ui build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "QuotaTide",
        "width": 360,
        "height": 430,
        "minWidth": 360,
        "minHeight": 430,
        "maxWidth": 360,
        "maxHeight": 602,
        "center": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray/tray-template.png",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": false,
      "tooltip": "QuotaTide"
    },
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDNkMzN0VFOTQwREU2QzEKUldUQjVnMlU3amRzL0xVTlFkTmgyY2dhYm1peGFtcndmS3dQUkJmaDlZcEp2cWhaVXMzQVQvZmoK",
      "endpoints": [
        "https://github.com/TheBlindM/QuotaTide/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "Utility",
    "copyright": "Copyright © 2026 TheBlind and QuotaTide contributors",
    "shortDescription": "A private Codex quota tray monitor.",
    "longDescription": "QuotaTide is an independent open-source tray application for monitoring one Codex account on this device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
